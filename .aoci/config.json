{
  "version": 2,
  "locale": "zh-CN",
  "index_path": "aoci.txt",
  "exclude_dirs": [
    "node_modules",
    "vendor",
    "dist",
    "build",
    "target",
    ".next",
    "coverage",
    "tmp",
    "uploads",
    "backup",
    "backups",
    "artifacts",
    ".output",
    "__pycache__",
    ".venv",
    "venv",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    ".tox",
    ".nox",
    "htmlcov"
  ],
  "exclude_files": [
    "*.backup.*",
    "*.bak",
    ".coverage"
  ],
  "exclude_exts": [],
  "curation_exclude": [
    "docs-site/public/og.png",
    "docs-site/public/workspace.png",
    "docs/hero.png",
    "docs/open-tag-workspace.png",
    "scripts/heal-dup-agent-names.ts",
    "web/public/apple-touch-icon.png",
    "web/public/favicon.ico",
    "web/public/og-image.png",
    "web/public/showcase/avatar.png"
  ],
  "hook_strict": false,
  "ledger_enabled": true,
  "line_ending_tolerance": true,
  "cognition_refresh_threshold": 30,
  "database_cognition_batch_objects": 21,
  "overview_delivery": {
    "chunk_tokens": 8000
  },
  "managed_scope": {
    "version": "managed-scope-policy/v2",
    "profile": "full",
    "observe_change_policy": "review_required",
    "approval_mode": "inherit",
    "approval_thresholds": {
      "entry_removal_count": 25,
      "entry_removal_percent": 25
    },
    "rules": []
  },
  "installed_agents": [
    "codex"
  ],
  "automation": {
    "mode": "auto"
  },
  "database_sources": [
    {
      "source_id": "primary",
      "engine": "postgresql",
      "database": "opentag",
      "namespaces": [
        "public"
      ],
      "credential_env": "AOCI_DB_PRIMARY_DSN",
      "connect_timeout_seconds": 10,
      "query_timeout_seconds": 30,
      "enabled": true
    }
  ],
  "ai": {
    "enabled": false,
    "provider": "openai-compatible",
    "base_url": "",
    "model": "",
    "api_key_env": "",
    "timeout_seconds": 0,
    "max_concurrency": 0,
    "max_input_tokens": 0,
    "token_accounting": "auto",
    "prompt_snapshot": "redacted"
  }
}
